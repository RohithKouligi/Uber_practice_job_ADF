{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "uberkouligidatafactory"
		},
		"AzureDatabricksjobrun_accessToken": {
			"type": "secureString",
			"metadata": "Secure string for 'accessToken' of 'AzureDatabricksjobrun'"
		},
		"ls_uber_dl_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_uber_dl'"
		},
		"ls_uber_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://raw.githubusercontent.com/"
		},
		"ls_uber_dl_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://uberdatalakekouligi.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "uberkouligidatafactory_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureDatabricksjobrun_accessToken": {
						"value": "[parameters('AzureDatabricksjobrun_accessToken')]"
					},
					"ls_uber_dl_accountKey": {
						"value": "[parameters('ls_uber_dl_accountKey')]"
					},
					"ls_uber_properties_typeProperties_url": {
						"value": "[parameters('ls_uber_properties_typeProperties_url')]"
					},
					"ls_uber_dl_properties_typeProperties_url": {
						"value": "[parameters('ls_uber_dl_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}